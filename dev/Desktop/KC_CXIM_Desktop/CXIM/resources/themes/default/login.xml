<?xml version="1.0" encoding="UTF-8"?>
<Window size="280,420" caption="0,0,0,28" shadow_attached="false" layered_window="true" size_box="0,0,0,0">
    <VBox width="stretch" height="stretch" border_round="8,8,8,8" bkcolor="#FFFFF7FB" bkcolor2="#FFE8F2FB" bkcolor2_direction="2">
        <HBox height="28">
            <Control width="stretch"/>
            <Button name="btn_window_min" width="18" height="18" margin="0,5,2,5" border_round="4,4"
                    normal_color="#00FFFFFF" hovered_color="#FFE8EEF5" pressed_color="#FFDDE7F2"
                    normal_text_color="#FF374151" font="system_regular_12" text="≡" cursor_type="hand"/>
            <Button name="btn_window_close" width="18" height="18" margin="0,5,10,5" border_round="4,4"
                    normal_color="#00FFFFFF" hovered_color="#FFFCE8E8" pressed_color="#FFF7D6D6"
                    normal_text_color="#FF374151" font="system_regular_12" text="✕" cursor_type="hand"/>
        </HBox>
        <VBox width="stretch" height="stretch" margin="25,0,25,0">
            <Box width="75" height="75" margin="0,6,0,0" halign="center" border_round="38,38" bkcolor="#FFFFFFFF">
                <Control width="44" height="44" halign="center" valign="center" bkimage="logo.png" mouse_enabled="false"/>
            </Box>
            <VBox width="stretch" height="auto" margin="0,15,0,0">
                <RichEdit2 class="simple simple_border prompt" name="username" width="stretch" height="36" border_size="0,0,0,0" border_round="8,8"
                           bkcolor="#FFFFFFFF" font="system_regular_12" text_align="hcenter,vcenter" text_padding="0,0,0,0"
                           prompt_text="输入账号" prompt_color="#FF9BA4B5"/>
                <RichEdit2 class="simple simple_border prompt" name="password" width="stretch" height="36" margin="0,7,0,0" border_size="0,0,0,0" border_round="8,8"
                           bkcolor="#FFFFFFFF" font="system_regular_12" text_align="hcenter,vcenter" text_padding="0,0,0,0"
                           password="true" prompt_text="输入密码" prompt_color="#FF9BA4B5"/>
            </VBox>
            <HBox height="18" margin="2,15,2,0">
                <CheckBox name="auto_login" width="auto" height="18" text="自动登录" font="system_regular_12"
                          text_padding="16,0,0,0" text_align="vcenter" valign="center" normal_text_color="#FF8D97A8"
                          normal_image="file='login_check_circle.svg' width='14' height='14' valign='center'"
                          selected_normal_image="file='login_check_circle_checked.svg' width='14' height='14' valign='center'"
                          cursor_type="hand"/>
                <Control width="stretch"/>
                <CheckBox name="remember_password" width="auto" height="18" text="记住密码" font="system_regular_12"
                          text_padding="16,0,0,0" text_align="vcenter" valign="center" normal_text_color="#FF8D97A8"
                          normal_image="file='login_check_circle.svg' width='14' height='14' valign='center'"
                          selected_normal_image="file='login_check_circle_checked.svg' width='14' height='14' valign='center'"
                          cursor_type="hand"/>
            </HBox>
            <Button name="btn_login" width="stretch" height="35" margin="0,40,0,0" border_round="8,8"
                    bkcolor="#FF7DC8F8" bkcolor2="#FF63B4EE" bkcolor2_direction="2"
                    normal_text_color="#FFFFFFFF" font="system_bold_16" text="登录" cursor_type="hand"/>
            <HBox width="stretch" height="20" margin="0,13,0,0">
                <Control width="stretch"/>
                <CheckBox name="agree_agreement" width="auto" height="20" text="已阅读并同意" font="system_regular_12"
                          text_padding="16,0,0,0" text_align="vcenter" valign="center" normal_text_color="#FF8D97A8"
                          normal_image="file='login_check_circle.svg' width='14' height='14' valign='center'"
                          selected_normal_image="file='login_check_circle_checked.svg' width='14' height='14' valign='center'"
                          cursor_type="hand"/>
                <Label text="服务协议" margin="2,0,0,0" valign="center" font="system_regular_12"
                       normal_text_color="#FF2C9BD6" cursor_type="hand"/>
                <Label text="和" margin="2,0,2,0" valign="center" font="system_regular_12"
                       normal_text_color="#FF8D97A8"/>
                <Label text="隐私政策" valign="center" font="system_regular_12"
                       normal_text_color="#FF2C9BD6" cursor_type="hand"/>
                <Control width="stretch"/>
            </HBox>
            <Control width="stretch" height="stretch"/>
            <Label name="login_error" width="stretch" height="16" margin="0,0,0,4" visible="false" text="登录失败"
                   font="system_regular_12" normal_text_color="#FFE14B4B" text_align="hcenter,vcenter"/>
            <HBox width="stretch" height="22" margin="0,0,0,20">
                <Control width="stretch"/>
                <Button name="register_account" width="auto" height="22" border_round="4,4"
                        normal_color="#00FFFFFF" hovered_color="#FFE8F4FD" pressed_color="#FFD8EBFA"
                        normal_text_color="#FF1F8DD6" font="system_regular_13" text="注册账号" cursor_type="hand"/>
                <Control width="stretch"/>
            </HBox>
        </VBox>
    </VBox>
</Window>
