{
  "listeners": [
    { "address": "0.0.0.0", "port": 8080, "https": false }
  ],
  "db_clients": [
    {
      "name": "default",
      "rdbms": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "dbname": "CXIMDB",
      "user": "cx_admin",
      "passwd": "CHANGE_ME",
      "connection_number": 4,
      "timeout": 5,
      "reconnect_interval": 1.0
    }
  ],
  "app": {
    "number_of_threads": 4,
    "enable_server_header": false,
    "log": {
      "log_level": "DEBUG",
      "log_path": "./logs",
      "logfile_base_name": "admin-backend",
      "log_size_limit": 10485760,
      "max_files": 5,
      "display_local_time": true
    }
  },
  "custom_config": {
    "admin": {
      "jwt_secret": "CHANGE_ME_32_BYTES_OR_MORE",
      "jwt_issuer": "kc-cxim-admin",
      "access_token_ttl_seconds": 900,
      "refresh_token_ttl_seconds": 604800,
      "cors_origin": "http://localhost:5173",
      "dev_mode": true
    }
  }
}
