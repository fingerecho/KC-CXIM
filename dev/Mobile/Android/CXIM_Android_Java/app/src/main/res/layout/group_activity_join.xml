<?xml version="1.0" encoding="utf-8"?>
<!-- 申请入群：群号 + 附言 + 提交，底部说明服务端没有群搜索能力 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Text.CXIM.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_label_group_id" />

        <EditText
            android:id="@+id/group_et_group_id"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_box"
            android:hint="@string/group_hint_group_id"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="19"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            style="@style/Text.CXIM.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/group_label_message" />

        <EditText
            android:id="@+id/group_et_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_box"
            android:gravity="top|start"
            android:hint="@string/group_hint_join_message"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="3"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/group_tv_msg_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textColor="@color/text_time"
            android:textSize="@dimen/text_time" />

        <Button
            android:id="@+id/group_btn_apply"
            style="@style/Widget.CXIM.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="14dp"
            android:text="@string/group_action_apply" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/group_join_note"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
