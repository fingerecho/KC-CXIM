<?xml version="1.0" encoding="utf-8"?>
<!-- 通讯录页（MainActivity 第二个 tab 的内容）：搜索 + 好友/群聊胶囊 + 列表 + 新建群聊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <!-- ===== 搜索框 + ＋ 按钮 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:contentDescription="@string/friend_search_hint"
            android:hint="@string/friend_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="@dimen/input_height"
            android:layout_height="@dimen/input_height"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/friend_menu_title"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <!-- ===== 好友 / 群聊 胶囊切换 ===== -->
    <LinearLayout
        android:id="@+id/tab_bar"
        style="@style/Widget.CXIM.TabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginEnd="@dimen/page_margin"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_friends"
            style="@style/Widget.CXIM.TabButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:checkable="true"
            android:checked="true"
            android:text="@string/tab_friends"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_groups"
            style="@style/Widget.CXIM.TabButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/tab_groups"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== 列表 + 空状态 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_contacts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp"
                android:scrollbars="none" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 好友页空状态 -->
        <LinearLayout
            android:id="@+id/empty_friends"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_empty_state">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/empty_friend"
                    android:src="@drawable/ic_contacts"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/empty_friend"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- 群聊页空状态 -->
        <LinearLayout
            android:id="@+id/empty_groups"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_empty_state">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/empty_group"
                    android:src="@drawable/ic_groups"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/empty_group"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== 底部：新建群聊（仅群聊 tab 可见） ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_group"
        style="@style/Widget.CXIM.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/page_margin"
        android:layout_marginBottom="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="@dimen/button_height"
        android:text="@string/friend_create_group_btn"
        android:visibility="gone" />
</LinearLayout>
