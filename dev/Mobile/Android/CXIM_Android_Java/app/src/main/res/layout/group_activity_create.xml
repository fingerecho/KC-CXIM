<?xml version="1.0" encoding="utf-8"?>
<!-- 新建群聊：群名表单 + 好友多选列表 + 底部创建按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Text.CXIM.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/group_label_group_name" />

        <EditText
            android:id="@+id/group_et_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_box"
            android:contentDescription="@string/group_hint_group_name"
            android:hint="@string/group_hint_group_name"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/group_create_tip"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_time" />

            <TextView
                android:id="@+id/group_tv_name_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_time"
                android:textSize="@dimen/text_time" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Text.CXIM.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/group_label_pick_friends" />

    <TextView
        android:id="@+id/group_tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:padding="28dp"
        android:text="@string/group_empty_no_friend"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/group_rv_friends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_h" />

    <Button
        android:id="@+id/group_btn_create"
        style="@style/Widget.CXIM.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_margin="12dp"
        android:text="@string/group_action_create" />
</LinearLayout>
