<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= 应用主题 ================= -->
    <style name="Theme.CXIM" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bubble_out</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_bottom</item>
        <item name="colorSurface">@color/panel_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:statusBarColor">@color/brand_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.CXIM.Button.Primary</item>
    </style>

    <!-- 登录 / 注册：渐变背景 + 浅色状态栏 -->
    <style name="Theme.CXIM.Auth" parent="Theme.CXIM">
        <item name="android:windowBackground">@drawable/bg_login_gradient</item>
        <item name="android:statusBarColor">@color/login_grad_bottom</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ================= 按钮 ================= -->
    <style name="Widget.CXIM.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_bottom</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="rippleColor">@color/brand_top</item>
    </style>

    <style name="Widget.CXIM.Button.Ghost" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ghost_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="android:minHeight">40dp</item>
        <item name="rippleColor">@color/ghost_pressed</item>
    </style>

    <style name="Widget.CXIM.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/danger_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="android:minHeight">40dp</item>
        <item name="rippleColor">@color/danger_pressed</item>
    </style>

    <!-- ================= 文本 ================= -->
    <!--
      Android 会用样式名的点号前缀做隐式父样式查找：
      Text.CXIM.Title 会去找 Text.CXIM，找不到就报 resource linking failed。
      这里显式定义两个空的基样式（parent="" 断开继承链）。
    -->
    <style name="Text.CXIM" parent="" />

    <style name="Widget.CXIM" parent="" />

    <style name="Text.CXIM.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.CXIM.Subtitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.CXIM.SectionLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.CXIM.Link">
        <item name="android:textColor">@color/brand_accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- ================= 顶部标题栏 ================= -->
    <style name="Widget.CXIM.Header">
        <item name="android:background">@drawable/bg_header_gradient</item>
        <item name="android:minHeight">@dimen/header_height</item>
    </style>

    <!-- ================= 输入框 ================= -->
    <style name="Widget.CXIM.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_card</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_card</item>
        <item name="boxStrokeColor">@color/brand_accent</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <!-- ================= 底部导航 ================= -->
    <style name="Widget.CXIM.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/panel_bg</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- ================= Tab（好友 / 群聊 胶囊） ================= -->
    <style name="Widget.CXIM.TabBar">
        <item name="android:background">@drawable/bg_tab_bar</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="Widget.CXIM.TabButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/tab_button_bg</item>
        <item name="android:textColor">@color/tab_button_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/radius_item</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
