<?xml version="1.0" encoding="utf-8"?>
<!-- 群发消息：多选目标 + 多行输入 + 发送 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_section_friends"
                style="@style/Text.CXIM.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp"
                android:text="@string/chat_multi_friends" />

            <LinearLayout
                android:id="@+id/container_friends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_elevated"
                android:divider="@drawable/divider_h"
                android:orientation="vertical"
                android:showDividers="middle|end" />

            <TextView
                android:id="@+id/tv_section_groups"
                style="@style/Text.CXIM.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp"
                android:text="@string/chat_multi_groups" />

            <LinearLayout
                android:id="@+id/container_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_elevated"
                android:divider="@drawable/divider_h"
                android:orientation="vertical"
                android:showDividers="middle|end" />

            <TextView
                android:id="@+id/tv_empty_targets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/chat_multi_empty_list"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- 输入 + 发送 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <EditText
            android:id="@+id/et_multi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_box"
            android:gravity="top|start"
            android:hint="@string/chat_multi_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_multi_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_multi_send"
            style="@style/Widget.CXIM.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chat_multi_send" />
    </LinearLayout>
</LinearLayout>
