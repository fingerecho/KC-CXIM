<?xml version="1.0" encoding="utf-8"?>
<!-- 群聊信息与管理：信息卡 + 编辑区（群主/管理员）+ 成员列表 + 底部操作按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/group_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 群资料卡 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.helloworld.ui.widget.AvatarView
                        android:id="@+id/group_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/group_tv_group_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/group_tv_meta"
                            style="@style/Text.CXIM.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/group_tv_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_announce"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/group_tv_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== 编辑区：仅群主 / 管理员可见 ===== -->
            <LinearLayout
                android:id="@+id/group_card_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CXIM.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_section_edit" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/group_edit_tip"
                    android:textColor="@color/text_time"
                    android:textSize="@dimen/text_time" />

                <EditText
                    android:id="@+id/group_et_edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="@string/group_hint_edit_name"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <EditText
                    android:id="@+id/group_et_edit_announcement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="top|start"
                    android:hint="@string/group_hint_edit_announcement"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minLines="3"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/group_btn_save"
                    style="@style/Widget.CXIM.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:minWidth="96dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/group_action_save" />
            </LinearLayout>

            <!-- ===== 成员区 ===== -->
            <TextView
                android:id="@+id/group_tv_members_title"
                style="@style/Text.CXIM.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/group_rv_members"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_card"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider_h" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel_bg"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/group_btn_invite"
            style="@style/Widget.CXIM.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/group_action_invite"
            android:visibility="gone" />

        <Button
            android:id="@+id/group_btn_quit"
            style="@style/Widget.CXIM.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/group_action_quit" />

        <Button
            android:id="@+id/group_btn_dismiss"
            style="@style/Widget.CXIM.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/group_action_dismiss"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
