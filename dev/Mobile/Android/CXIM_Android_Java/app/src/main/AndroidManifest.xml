<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 长连接 + HTTP 控制面 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 以下读取待发送的图片/文件 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CXIMApp"
        android:allowBackup="true"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CXIM"
        tools:targetApi="31">

        <!-- 接收者收发消息需要网络权限外的文件分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.CXIM.Auth"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegisterActivity"
            android:theme="@style/Theme.CXIM.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ServerSettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ChatActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AddFriendActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FriendRequestsActivity" />

        <activity
            android:name=".ui.CreateGroupActivity" />

        <activity
            android:name=".ui.GroupDetailActivity" />

        <activity
            android:name=".ui.GroupRequestsActivity" />

        <activity
            android:name=".ui.InviteMembersActivity" />

        <activity
            android:name=".ui.GroupJoinActivity" />

        <activity
            android:name=".ui.FileViewerActivity" />

        <activity
            android:name=".ui.MultiSendActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
