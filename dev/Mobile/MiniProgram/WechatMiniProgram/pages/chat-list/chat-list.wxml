<view class="page">
  <!-- 连接状态条 -->
  <view class="state-bar" wx:if="{{!connected}}">
    连接已断开，正在自动重连...
  </view>

  <!-- 群聊快捷入口 -->
  <view class="quick-bar">
    <view class="quick-item" bindtap="goGroupList" hover-class="quick-hover">
      <view class="quick-icon quick-icon-group">群</view>
      <text class="quick-text">我的群</text>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item" bindtap="goCreateGroup" hover-class="quick-hover">
      <view class="quick-icon quick-icon-plus">+</view>
      <text class="quick-text">发起群聊</text>
    </view>
  </view>

  <view wx:if="{{sessions.length === 0}}" class="empty">
    暂无会话，去联系人页面发起聊天或创建一个群吧
  </view>

  <view
    class="session"
    wx:for="{{sessions}}"
    wx:key="id"
    data-id="{{item.id}}"
    data-name="{{item.name}}"
    data-isgroup="{{item.isGroup ? 1 : 0}}"
    bindtap="openChat"
    hover-class="session-hover"
  >
    <view class="avatar avatar-md {{item.avatarCls}}">{{item.avatarChar}}</view>
    <view class="session-main">
      <view class="session-top">
        <text class="session-name">{{item.name}}</text>
        <text class="session-time">{{item.time}}</text>
      </view>
      <view class="session-bottom">
        <text class="session-preview">{{item.lastMsg.content}}</text>
        <view class="badge" wx:if="{{item.unread > 0}}">{{item.unread > 99 ? '99+' : item.unread}}</view>
      </view>
    </view>
  </view>
</view>
