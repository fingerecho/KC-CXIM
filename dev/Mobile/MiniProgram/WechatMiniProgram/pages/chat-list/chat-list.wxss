.state-bar {
  background: #fff7e6;
  color: #d48806;
  font-size: 24rpx;
  padding: 14rpx 32rpx;
}

.quick-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-hover { opacity: 0.6; }
.quick-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--line);
}
.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}
.quick-icon-group { background: #8e6bf1; }
.quick-icon-plus { background: #22b573; font-size: 44rpx; }
.quick-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-main);
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.session {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.session-hover {
  background: #f7f8fa;
}
.session-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.session-top {
  display: flex;
  align-items: center;
}
.session-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-time {
  color: var(--text-sub);
  font-size: 24rpx;
  margin-left: 16rpx;
}
.session-bottom {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}
.session-preview {
  flex: 1;
  color: var(--text-sub);
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
