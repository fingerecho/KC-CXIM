<view class="login-page">
  <view class="logo">
    <view class="logo-icon">铖</view>
    <view class="logo-name">铖信</view>
    <view class="logo-sub">安全 · 稳定 · 即时通讯</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="field-label">用户名</text>
      <input
        class="field-input"
        placeholder="请输入用户名"
        placeholder-class="ph"
        value="{{username}}"
        bindinput="onUsername"
      />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        placeholder="请输入密码（6~72 位）"
        placeholder-class="ph"
        value="{{password}}"
        bindinput="onPassword"
      />
    </view>
    <view class="field" wx:if="{{mode === 'register'}}">
      <text class="field-label">确认密码</text>
      <input
        class="field-input"
        password
        placeholder="再次输入密码"
        placeholder-class="ph"
        value="{{confirmPwd}}"
        bindinput="onConfirmPwd"
      />
    </view>

    <button class="btn-primary login-btn" loading="{{loading}}" bindtap="onSubmit">
      {{mode === 'login' ? '登 录' : '注 册'}}
    </button>
    <view class="switch-mode" bindtap="switchMode">
      {{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}
    </view>
    <view class="state-text" wx:if="{{stateText}}">{{stateText}}</view>
  </view>
</view>
