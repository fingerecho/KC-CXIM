.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--line);
}
.tabs { display: flex; }
.tab {
  padding: 28rpx 20rpx;
  font-size: 30rpx;
  color: var(--text-sub);
  position: relative;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-active { color: var(--primary); font-weight: 500; }
.tab-active::after {
  content: '';
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.tab-badge {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  margin-left: 6rpx;
  vertical-align: middle;
}
.actions { display: flex; align-items: center; }
.action {
  font-size: 26rpx;
  color: var(--primary);
  padding: 12rpx 18rpx;
  margin-left: 8rpx;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 10rpx;
}
.action-hover { opacity: 0.7; }

.group-item { background: #fff; border-bottom: 1rpx solid var(--line); }
.group-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}
.group-row-hover { background: #f7f8fa; }
.group-main { flex: 1; min-width: 0; margin-left: 24rpx; }
.group-name {
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.group-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 8rpx; }
.role-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: #e8f0ff;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}
.group-info-entry {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 0 32rpx 20rpx;
}

.section-title {
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 20rpx 32rpx 12rpx;
}
.empty-empty {
  text-align: center;
  color: var(--text-sub);
  padding: 48rpx 0;
  font-size: 26rpx;
  background: #fff;
}
.divider { height: 16rpx; }
.contact-name {
  margin-left: 20rpx;
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.contact-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}
.contact-main .contact-name { margin-left: 0; }
.contact-msg {
  color: var(--text-sub);
  font-size: 24rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.req-btn {
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.req-accept { background: var(--primary); color: #fff; }
.req-reject { background: #fff; color: var(--text-sub); border: 1rpx solid var(--line); }
.status-text { font-size: 24rpx; color: var(--text-sub); margin-left: 16rpx; }
