.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.ph {
  color: #c0c5cc;
}
.search-btn {
  margin-left: 20rpx;
  color: var(--primary);
  font-size: 30rpx;
  padding: 8rpx 12rpx;
}
.search-btn-hover {
  opacity: 0.6;
}

.section-title {
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 20rpx 32rpx 12rpx;
}

.divider {
  height: 16rpx;
}

.empty-empty {
  text-align: center;
  color: var(--text-sub);
  padding: 48rpx 0;
  font-size: 26rpx;
  background: #fff;
}

.contact-name {
  margin-left: 24rpx;
  flex: 1;
  font-size: 30rpx;
}
.contact-main {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}
.contact-main .contact-name {
  margin-left: 0;
}
.contact-msg {
  color: var(--text-sub);
  font-size: 24rpx;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-btn {
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.add-btn-hover {
  opacity: 0.7;
}

.req-btn {
  font-size: 26rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}
.req-accept {
  background: var(--primary);
  color: #fff;
}
.req-reject {
  background: #fff;
  color: var(--text-sub);
  border: 1rpx solid var(--line);
}
